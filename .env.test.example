# Ambiente per i test di autorizzazione e integrazione.
#
# Copiare in `.env.test.local` (ignorato da git) e avviare il contenitore con
# `npm run test:db:up`. L'URL non deve mai puntare al progetto Supabase
# dell'applicazione: `scripts/test-db/connect.ts` lo rifiuta, e il database
# deve inoltre dichiararsi di prova (`npm run test:db:bootstrap`).
TEST_DATABASE_URL=postgres://postgres:kaipai_test_pw@localhost:55432/kaipai_test
