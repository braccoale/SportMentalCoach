# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
POSTGRES_URL=postgresql://***
BASE_URL=http://localhost:3000
AUTH_SECRET=***

# Google Analytics 4. Public measurement ID. The production fallback is the
# KaiPai stream (G-773FBGVP7J); set this to use a different stream in previews.
# The tag is not loaded until the visitor explicitly accepts analytics cookies.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Billing (Stripe). Phase 1 default: disabled.
# When BILLING_ENABLED=false the app runs without STRIPE_SECRET_KEY: Stripe
# API routes return 404, /pricing returns 404, the seed skips Stripe products,
# and billing-related UI (pricing nav link, subscription card) is hidden.
# Set both flags to 'true' and provide the Stripe keys to re-enable billing.
BILLING_ENABLED=false
NEXT_PUBLIC_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Video calls (LiveKit). Optional — leave empty to disable video. When unset,
# the video room page shows a setup message and the app starts normally
# (these vars are never required at startup). Tokens are generated server-side
# from LIVEKIT_API_KEY / LIVEKIT_API_SECRET; the browser connects to
# NEXT_PUBLIC_LIVEKIT_URL (e.g. wss://your-project.livekit.cloud).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# AI Session Notes Phase 2A: private, audio-only LiveKit Track Egress.
# Recording fails closed unless every value below is present. Generate dedicated
# server-only S3 access keys in Supabase Storage settings; never expose them as
# NEXT_PUBLIC_* and never persist them in the database. The endpoint must be:
# https://<project-ref>.storage.supabase.co/storage/v1/s3
# The dedicated bucket is created/verified as private by the backend. Raw audio
# retention defaults to the documented MVP proposal of 7 days (allowed 1..30).
# The 128 MiB default size ceiling and 180-minute safety stop are configurable.
AI_NOTES_AUDIO_S3_ENDPOINT=
AI_NOTES_AUDIO_S3_REGION=
AI_NOTES_AUDIO_S3_ACCESS_KEY=
AI_NOTES_AUDIO_S3_SECRET_KEY=
AI_NOTES_AUDIO_BUCKET=ai-session-audio
AI_NOTES_AUDIO_RETENTION_DAYS=7
AI_NOTES_AUDIO_MAX_BYTES=134217728
AI_NOTES_AUDIO_SAFETY_TIMEOUT_MINUTES=180
# Verified LiveKit webhook events older than this are rejected. The one-day
# default leaves room for provider retries while the event-ID ledger blocks replay.
LIVEKIT_WEBHOOK_MAX_AGE_SECONDS=86400

# AI Session Notes Phase 3A: off by default. These values are server-only.
AI_NOTES_STT_PROVIDER=disabled
DEEPGRAM_API_KEY=
AI_NOTES_STT_MODEL=nova-3
AI_NOTES_STT_TIMEOUT_MS=60000

# Realtime chat (Supabase Realtime). Optional — leave empty to disable. When
# unset, chat still works with server-rendered messages + manual refresh;
# realtime only adds live updates. Uses Supabase Broadcast (a content-free
# "new message" signal); message content is always fetched from the
# participant-guarded server, never sent over the realtime channel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# File storage for uploaded media (coach presentation videos, avatars).
# Optional — leave empty to store uploads on the local filesystem under
# public/uploads/ (fine for local dev). On serverless / read-only hosts, set
# these to store in Supabase Storage instead: create a PUBLIC bucket (default
# name "media", override with SUPABASE_STORAGE_BUCKET) and provide the URL
# (SUPABASE_URL or the existing NEXT_PUBLIC_SUPABASE_URL) plus the service-role
# key (server-only secret). See lib/core/storage.ts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Email notifications. Optional and OFF by default. Email is a channel of its
# own, side by side with the in-app notification (which remains the source of
# truth) and web push. Sent only when EMAIL_NOTIFICATIONS_ENABLED=true AND the
# provider key + a from-address are set; otherwise sending is skipped (and
# logged) and the app runs normally. The provider is never required at startup,
# and a failed email never breaks the action that triggered it.
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=

# Sender identity. Deliberately NOT a noreply@ address: replies must reach a
# human. A future notifications@kaipaicoaching.com only needs these values changed.
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=info@kaipaicoaching.com
EMAIL_FROM_NAME=KaiPai
EMAIL_REPLY_TO=info@kaipaicoaching.com

# Legacy fallback for EMAIL_FROM_ADDRESS. Kept working for deployments
# configured before the split; leave empty on new environments.
RESEND_FROM_EMAIL=
