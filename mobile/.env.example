# Copia questo file in `mobile/.env` e riempilo dai valori del progetto web.
# `EXPO_PUBLIC_` non è un dettaglio: senza quel prefisso Expo non espone la
# variabile all'app. Qui non va mai nulla di segreto — finisce dentro il
# pacchetto installato sul telefono, che è leggibile.

# In sviluppo punta al tuo computer, non a localhost: dal telefono
# "localhost" è il telefono stesso. Usa l'IP della macchina sulla rete.
EXPO_PUBLIC_API_BASE_URL=https://www.kaipaicoaching.com

# Gli stessi due valori di .env.local del progetto web.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
